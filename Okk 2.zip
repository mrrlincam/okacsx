app.post("/api/download", async (req, res) => {

    const { url } = req.body;

    if (!url || !/^https?:\/\/(www\.|vm\.|vt\.)?tiktok\.com\//i.test(url)) {
        return res.status(400).json({
            success: false,
            error: "TikTok Link áá·ááááá¹ááááá¼á!"
        });
    }

    try {

        const response = await axios.post(
            "https://www.tikwm.com/api/",
            {
                url: url,
                hd: 1
            },
            {
                timeout: 30000,
                headers: {
                    "Content-Type": "application/json",
                    "User-Agent": "Mozilla/5.0"
                }
            }
        );

        const result = response.data;
        const d = result?.data;

        if (result?.code !== 0 || !d) {
            return res.status(400).json({
                success: false,
                error: "áááá·ááá¾ááá¸ááá¢á¼!"
            });
        }

        res.json({
            success: true,
            title: d.title || "TikTok Video",
            cover: d.cover || "",
            play: d.hdplay || d.play || "",
            music: d.music || "",
            author: d.author?.nickname || "TikTok"
        });

    } catch (error) {

        console.error(error.message);

        res.status(500).json({
            success: false,
            error: "Server á¬ TikTok API áá¶ááááá á¶!"
        });

    }

});

app.listen(PORT, "0.0.0.0", () => {
